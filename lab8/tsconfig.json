{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": [
      "jest",
      "react",
      "react-native"
    ]
  },
  "include": [
    "App.tsx",
    "src",
    "__tests__",
    "jest.setup.js",
    "jest.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
